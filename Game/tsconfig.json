{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "noImplicitAny": false,
    "target": "es2022",
    "allowJs": true,
    "preserveConstEnums": true,
    "sourceMap": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "./src",
    "outDir": "./dist",
    "strictPropertyInitialization": false,
    "strictNullChecks": false
  },
  "include": ["src/**/*"]
}
